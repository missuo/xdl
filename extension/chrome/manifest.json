{
  "manifest_version": 3,
  "name": "XDL — Send to Downloader",
  "version": "1.1",
  "description": "Send the current X/Twitter profile to the XDL desktop app, which fetches and downloads all of its media.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send this profile to XDL",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:47333/*"]
}
